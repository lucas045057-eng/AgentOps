# Copy this file to .env and replace the placeholder values.
DATABASE_URL=projects.db
PROGRESS_DATABASE_URL=progress.db
API_KEY=replace-with-a-long-random-value
SCRIPT_ROOT=scripts
EXTERNAL_SCRIPT_ROOT=/app/external/daily
# Host source directory: only this directory is imported by the catalog.
DAILY_SCRIPTS_ROOT=/mnt/e/项目脚本/日签/自动日签项目
RUNNER_CATALOG_PATH=config/runner_catalog.json
RUNNER_WORKSPACE_ROOT=/tmp/airdrop-runs
EXECUTION_LOG_ROOT=logs/executions
EXECUTION_TIMEOUT=900
ALLOW_INTERACTIVE=false
EXECUTION_PLATFORM=linux
SYNC_RUNNER_CATALOG_ON_STARTUP=true
AUTO_RUN_ON_STARTUP=false
AUTO_RUN_INTERVAL_MINUTES=0
# Empty means all enabled workflows; when set, catalog IDs select the related project workflows.
AUTO_RUN_CATALOG_IDS=
# Internal copied scripts: generate this many wallets on first project run.
AIRDROP_WALLET_COUNT=1
AIRDROP_APPEND_WALLET_COUNT=0
AIRDROP_AUTO_PROVISION=1
AIRDROP_THREADS=5
FORTUNE_MODE=1
SIMPLE_MODE=1
SWARMBASE_TASK_COUNT=0
AIRDROP_REFERRAL_ADDRESS=
WINDOWS_WORKER_URL=
WINDOWS_WORKER_TOKEN=
WINDOWS_WORKER_TIMEOUT=930
STARTUP_SCRIPT_IDS=

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_RECEIVER=

HOST=0.0.0.0
PORT=8000
DEBUG=false
